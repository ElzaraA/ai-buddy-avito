# Адрес сервера
ADDR=:8080
# true — mock-LLM без ключа и интернета (по умолчанию для демо). Без LLM_API_KEY всегда mock.
LLM_MOCK=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Ключ не коммитить
LLM_API_KEY=
# false — при сбое реальной LLM не переключаться на резервную модель
LLM_FALLBACK=true
# Файл снимка состояния (заявки, чек-листы, диалоги). Пусто — только в памяти.
STATE_FILE=
# Вопросов в минуту на пользователя; 0 — без ограничения
RATE_LIMIT_PER_MIN=60
# Папка базы знаний
KNOWLEDGE_DIR=data/knowledge
# Разрешённые origin фронта через запятую (по умолчанию localhost:5173, 127.0.0.1:5173, localhost:3000)
CORS_ORIGINS=

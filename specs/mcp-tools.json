{
  "tools": [
    {
      "name": "checklist_get",
      "description": "Возвращает статус чек-листа и следующий шаг",
      "permission": "checklist.read",
      "input_schema": {"type": "object", "properties": {}}
    },
    {
      "name": "absence_create_request",
      "description": "Создаёт заявку на отгул",
      "permission": "absence.create",
      "input_schema": {
        "type": "object",
        "required": ["dateFrom", "dateTo"],
        "properties": {
          "dateFrom": {"type": "string", "format": "date"},
          "dateTo": {"type": "string", "format": "date"},
          "reason": {"type": "string"}
        }
      }
    },
    {
      "name": "directory_find_owner",
      "description": "Ищет ответственного по теме",
      "permission": "directory.read",
      "input_schema": {
        "type": "object",
        "required": ["query"],
        "properties": {"query": {"type": "string"}}
      }
    }
  ]
}